---
import Icon from './Icon.astro';
import { tr, type Locale } from '../i18n';
import type { Edition } from '../lib/content';

interface Props {
  locale: Locale;
  items: Edition['data']['attractions'];
}

const { locale, items } = Astro.props;
---

<ul role="list" class="attractions">
  {
    items.map((a, i) => (
      <li class="attraction" style={`--i:${i}`}>
        <span class="attraction__icon">
          <Icon name={a.icon ?? 'sparkles'} size={26} stroke-width={1.8} />
        </span>
        <h3 class="attraction__title">{tr(a.title, locale)}</h3>
        {a.description && <p class="attraction__text">{tr(a.description, locale)}</p>}
      </li>
    ))
  }
</ul>

<style>
  .attractions {
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .attraction {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-l);
    border: 1px solid var(--c-line);
    background: linear-gradient(160deg, var(--c-bg-3), var(--c-bg-2));
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .attraction:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .attraction__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: var(--c-ink);
    background: linear-gradient(var(--c-yellow) 50%, var(--c-red) 50%);
  }

  .attraction:nth-child(3n + 2) .attraction__icon {
    background: var(--c-yellow);
  }

  .attraction:nth-child(3n) .attraction__icon {
    background: var(--c-pink);
  }

  .attraction__title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: 0.01em;
  }

  .attraction__text {
    color: var(--c-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }
</style>
