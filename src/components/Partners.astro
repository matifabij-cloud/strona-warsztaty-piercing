---
import Img from './Img.astro';
import { tr, useUI, type Locale } from '../i18n';
import type { Edition } from '../lib/content';

interface Props {
  locale: Locale;
  items: Edition['data']['partners'];
}

const { locale, items } = Astro.props;
const t = useUI(locale);

// Liczba kolumn na dużym ekranie dobrana tak, żeby rzędy były możliwie pełne (np. 7 → 4 + 3).
const n = items.length;
const cols = n <= 6 ? n : n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : n % 5 === 0 ? 5 : 4;
---

<ul role="list" class="partners" style={`--cols:${Math.max(cols, 1)}`}>
  {
    items.map((p) => {
      const inner = p.logo ? (
        <Img src={p.logo} alt={p.name} widths={[240, 480]} sizes="12rem" class="partner__logo" />
      ) : (
        <span class="partner__name">{p.name}</span>
      );
      return (
        <li class="partner">
          {p.url ? (
            <a href={p.url} target="_blank" rel="noopener noreferrer" title={`${p.name} ${t('misc.newTab')}`}>
              {inner}
              {p.role && <span class="partner__role">{tr(p.role, locale)}</span>}
            </a>
          ) : (
            <span>
              {inner}
              {p.role && <span class="partner__role">{tr(p.role, locale)}</span>}
            </span>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 30rem) {
    .partners {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Nieparzysta liczba: ostatni na całą szerokość */
    .partner:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 72rem) {
    .partners {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }

  .partner > a,
  .partner > span {
    display: grid;
    place-items: center;
    min-height: 6rem;
    padding: 1.1rem;
    border-radius: var(--radius);
    background: var(--c-paper);
    color: var(--c-paper-text);
    text-decoration: none;
    text-align: center;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .partner > a:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 0 3px var(--c-yellow);
  }

  .partner :global(.partner__logo) {
    max-height: 3.5rem;
    width: auto;
    object-fit: contain;
  }

  .partner > a,
  .partner > span {
    align-content: center;
    gap: 0.45rem;
  }

  .partner__role {
    font-size: var(--step--2);
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-paper-muted);
  }

  .partner__name {
    font-weight: 800;
    font-size: var(--step-0);
    line-height: 1.2;
  }
</style>
