---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { alternatesFor, formatDate, paths, tr, useUI, type Locale } from '../i18n';
import { md } from '../lib/markdown';

interface Props {
  locale: Locale;
  id: 'polityka-prywatnosci' | 'regulamin-konkursu' | 'zasady-glosowania';
}

const { locale, id } = Astro.props;
const t = useUI(locale);
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`Brak strony src/content/pages/${id}.md`);
const title = tr(entry.data.title, locale);
const html = md(tr(entry.body ?? '', locale));
const pagePath = { 'polityka-prywatnosci': paths.privacy, 'regulamin-konkursu': paths.contestRules, 'zasady-glosowania': paths.votingRules };
// Regulamin dla artystów i zasady głosowania dla publiczności odsyłają do siebie nawzajem.
const related =
  id === 'regulamin-konkursu'
    ? { href: paths.votingRules(locale), label: t('footer.votingRules') }
    : id === 'zasady-glosowania'
      ? { href: paths.contestRules(locale), label: t('footer.contestRules') }
      : undefined;
---

<Base locale={locale} title={title} description={title} alternates={alternatesFor(pagePath[id])}>
  <article class="section legal">
    <div class="container--narrow">
      <h1 class="display legal__title">{title}</h1>
      {entry.data.updated && <p class="legal__meta">{t('legal.updated', { date: formatDate(entry.data.updated, locale) })}</p>}
      {locale !== 'pl' && t('legal.binding') && <p class="legal__note">{t('legal.binding')}</p>}
      {
        related && (
          <p class="legal__related">
            <a href={related.href}>{related.label} →</a>
          </p>
        )
      }
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-top: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .legal__title {
    font-size: var(--step-4);
    margin-bottom: 0.75rem;
  }

  .legal__meta {
    color: var(--c-muted);
    font-size: var(--step--1);
    margin-bottom: 2rem;
  }

  .legal__note {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--c-yellow);
    background: var(--c-bg-2);
    margin-bottom: 2rem;
    font-size: var(--step--1);
  }

  .legal__related {
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .legal__related a {
    color: var(--c-yellow);
  }

  .legal .prose {
    color: var(--c-muted);
  }
</style>
