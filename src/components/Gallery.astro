---
import { getImage } from 'astro:assets';
import GalleryTile from './GalleryTile.astro';
import Icon from './Icon.astro';
import { useUI, type Locale } from '../i18n';
import { dims, resolveMediaList } from '../lib/media';

interface Props {
  locale: Locale;
  images: string[];
  /** Podpis używany w tekstach alternatywnych, np. „III edycja” */
  label: string;
  /** Ile zdjęć pokazać od razu (reszta po kliknięciu „Pokaż wszystkie”). */
  initial?: number;
  /** Zamiast odsłaniania reszty – link do pełnej galerii. */
  moreHref?: string;
  id?: string;
}

const { locale, images, label, initial = 12, moreHref, id = 'gallery' } = Astro.props;
const t = useUI(locale);
const items = await resolveMediaList(images);
const shown = moreHref ? items.slice(0, initial) : items;

const tiles = await Promise.all(
  shown.map(async ({ image }, i) => {
    const size = dims(image);
    const full = await getImage({ src: image, width: Math.min(1800, size.width), format: 'webp', quality: 80 });
    return {
      image,
      ratio: +(size.width / size.height).toFixed(3),
      full: full.src,
      alt: t('gallery.alt', { edition: label, n: i + 1 }),
    };
  }),
);
// Pierwsze zdjęcia i reszta to dwie osobne siatki – odsłonięcie reszty nie przestawia tych, które już widać.
const first = moreHref ? tiles : tiles.slice(0, initial);
const rest = moreHref ? [] : tiles.slice(initial);
---

{
  tiles.length > 0 && (
    <div class:list={['gallery', { 'gallery--row': tiles.length <= 4 }]} data-gallery id={id}>
      <div class="gallery__photos">
        <ul role="list" class="gallery__grid">
        {first.map((tile, i) => <GalleryTile locale={locale} {...tile} index={i} />)}
      </ul>
      {rest.length > 0 && (
        <div class="gallery__rest" data-gallery-rest hidden>
          <ul role="list" class="gallery__grid">
            {rest.map((tile, i) => <GalleryTile locale={locale} {...tile} index={first.length + i} />)}
          </ul>
        </div>
      )}
      </div>

      {rest.length > 0 && (
        <button type="button" class="btn gallery__more" data-gallery-more>
          <Icon name="images" size={18} />
          {t('cta.showAllPhotos', { n: tiles.length })}
        </button>
      )}
      {moreHref && items.length > shown.length && (
        <a class="btn gallery__more" href={moreHref}>
          <Icon name="images" size={18} />
          {t('cta.showAllPhotos', { n: items.length })}
        </a>
      )}
    </div>
  )
}



<style>
  .gallery {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
  }

  /*
   * Układ „justified”: zdjęcia w równych rzędach na całą szerokość, bez przycinania.
   * Każde zdjęcie rośnie proporcjonalnie do swoich proporcji (--r), więc w rzędzie mają tę samą wysokość.
   */
  .gallery {
    --gap: clamp(0.5rem, 0.35rem + 0.6vw, 0.9rem);
    --row-h: 6.5rem;
  }

  @media (min-width: 40rem) {
    .gallery {
      --row-h: 11rem;
    }
  }

  @media (min-width: 72rem) {
    .gallery {
      --row-h: 14rem;
    }
  }

  .gallery__grid {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  /* Ostatni rząd nie rozciąga się na siłę */
  .gallery__grid::after {
    content: '';
    flex-grow: 1000;
  }

  /* Mało zdjęć: na większym ekranie wszystkie w jednym rzędzie, na całą szerokość */
  @media (min-width: 40rem) {
    .gallery--row .gallery__grid {
      flex-wrap: nowrap;
    }
    .gallery--row .gallery__grid::after {
      content: none;
    }
  }

  .gallery :global(.gallery__item) {
    flex: var(--r) 1 calc(var(--r) * var(--row-h));
    min-width: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--c-bg-3);
  }

  .gallery__photos {
    width: 100%;
  }

  /* Reszta zdjęć wysuwa się płynnie */
  .gallery__rest {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.9s var(--ease),
      opacity 0.6s var(--ease);
  }

  .gallery__rest[hidden] {
    display: none;
  }

  .gallery__rest.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .gallery__rest > .gallery__grid {
    min-height: 0;
    overflow: hidden;
    padding-top: var(--gap);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__rest {
      transition: none;
    }
  }

  .gallery :global(.gallery__item a) {
    display: block;
    cursor: zoom-in;
  }

  .gallery :global(.gallery__item img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    object-fit: cover;
    transition: scale 0.5s var(--ease);
  }

  .gallery :global(.gallery__item a:hover img) {
    scale: 1.04;
  }
</style>
