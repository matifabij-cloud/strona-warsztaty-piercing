---
import { tr, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  stats: { value: string; label: string }[];
  variant?: 'band' | 'inline';
}

const { locale, stats, variant = 'band' } = Astro.props;
---

{
  stats.length > 0 && (
    <div class:list={['stats', `stats--${variant}`]}>
      <dl class="stats__list">
        {stats.map((s) => (
          <div class="stats__item">
            <dt>{tr(s.label, locale)}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  .stats--band {
    border-block: 1px solid var(--c-line);
    background: var(--c-bg-2);
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats--band .stats__list {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .stats__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem) clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    border-left: 1px solid var(--c-line);
  }

  .stats__item:nth-child(odd) {
    border-left: 0;
  }

  @media (min-width: 48rem) {
    .stats__item:nth-child(odd) {
      border-left: 1px solid var(--c-line);
    }
    .stats__item:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .stats__item:nth-child(n + 3) {
      border-top: 1px solid var(--c-line);
    }
    .stats__item:nth-child(odd) {
      padding-left: 0;
    }
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.8rem + 3vw, 4rem);
    line-height: 1;
    color: var(--accent);
  }

  .stats dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--c-muted);
    line-height: 1.35;
  }

  .stats--inline .stats__item {
    padding-block: 0.5rem;
  }
</style>
