---
import Img from './Img.astro';
import { useUI, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  image: ImageMetadata;
  ratio: number;
  full: string;
  alt: string;
  index: number;
}

const { locale, image, ratio, full, alt, index } = Astro.props;
const t = useUI(locale);
---

<li class="gallery__item" style={`--r:${ratio}`}>
  <a href={full} data-full={full} data-index={index} aria-label={t('gallery.open', { n: index + 1 })}>
    <Img src={image} alt={alt} widths={[360, 540, 800]} sizes={`(min-width: 72rem) ${Math.round(ratio * 14 * 16 * 1.4)}px, (min-width: 40rem) ${Math.round(ratio * 11 * 16 * 1.3)}px, 50vw`} quality={72} />
  </a>
</li>
