---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-znak.png';
import Wordmark from '../assets/brand/wordmark.svg';

interface Props {
  href?: string;
  label?: string;
  size?: 'header' | 'footer' | 'hero';
  class?: string;
}

const { href, label = 'Łódzkie Warsztaty Piercingu', size = 'header', class: className } = Astro.props;
const markSize = { header: 44, footer: 72, hero: 120 }[size];
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['logo', `logo--${size}`, className]} aria-label={href ? label : undefined}>
  <Image src={mark} alt="" width={markSize} height={markSize} densities={[1, 2]} class="logo__mark" loading="eager" />
  <Wordmark class="logo__word" aria-hidden="true" />
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--c-text);
    text-decoration: none;
    flex: none;
  }

  .logo__mark {
    width: var(--mark);
    height: var(--mark);
    flex: none;
    transition: transform 0.4s var(--ease);
  }

  a.logo:hover .logo__mark {
    transform: rotate(-12deg);
  }

  .logo__word {
    height: var(--word);
    width: auto;
  }

  .logo--header {
    --mark: 2.5rem;
    --word: 1.95rem;
  }

  @media (min-width: 64rem) {
    .logo--header {
      --mark: 2.75rem;
      --word: 2.2rem;
    }
  }

  .logo--footer {
    --mark: 3.75rem;
    --word: 3rem;
    gap: 0.9rem;
  }

  .logo--hero {
    --mark: 6rem;
    --word: 5rem;
    gap: 1.2rem;
  }
</style>
