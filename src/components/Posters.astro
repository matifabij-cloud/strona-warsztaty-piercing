---
import { getImage } from 'astro:assets';
import Img from './Img.astro';
import { useUI, type Locale } from '../i18n';
import { dims, resolveMediaList } from '../lib/media';

interface Props {
  locale: Locale;
  images: string[];
  label: string;
}

const { locale, images, label } = Astro.props;
const t = useUI(locale);
const items = await Promise.all(
  (await resolveMediaList(images)).map(async ({ image }) => ({
    image,
    full: (await getImage({ src: image, width: Math.min(1600, dims(image).width), format: 'webp', quality: 82 })).src,
    ratio: dims(image).width / dims(image).height,
  })),
);
// Plakaty mają różne proporcje – wszystkie dostają tę samą wysokość. Na dużym ekranie,
// jeśli zmieszczą się w rozsądnej wysokości, wypełniają jeden równy rząd bez przewijania.
const sum = items.reduce((a, p) => a + p.ratio, 0);
const fit = sum >= 2.8 && sum <= 5.5;
---

{
  items.length > 0 && (
    <ul role="list" class:list={['posters', { 'posters--fit': fit }]} data-gallery>
      {items.map((p, i) => (
        <li style={`--r:${p.ratio.toFixed(4)}`}>
          <a href={p.full} data-full={p.full} aria-label={t('gallery.open', { n: i + 1 })}>
            <Img src={p.image} alt={t('gallery.posterAlt', { edition: label })} widths={[300, 460, 640]} sizes="(min-width: 72rem) 20vw, 21rem" />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posters {
    --h: clamp(15rem, 10rem + 18vw, 21rem);
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }

  .posters li {
    flex: 0 0 auto;
    width: calc(var(--h) * var(--r));
    scroll-snap-align: start;
  }

  /* Jeden rząd na całą szerokość: szerokość każdego plakatu proporcjonalna do jego kształtu */
  @media (min-width: 72rem) {
    .posters--fit {
      overflow: visible;
    }

    .posters--fit li {
      flex: var(--r) 1 0;
      width: auto;
      min-width: 0;
    }
  }

  .posters a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: 0 0 0 1px var(--c-line);
    transition: transform 0.3s var(--ease);
  }

  .posters a:hover {
    transform: translateY(-4px) rotate(-1deg);
  }

  .posters :global(img) {
    width: 100%;
  }
</style>
