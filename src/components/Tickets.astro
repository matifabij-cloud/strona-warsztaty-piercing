---
import Icon from './Icon.astro';
import { tr, useUI, type Locale } from '../i18n';
import type { Edition } from '../lib/content';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
  edition: Edition;
}

const { locale, edition } = Astro.props;
const t = useUI(locale);
const tickets = edition.data.tickets ?? { status: 'wkrotce' as const, url: undefined, info: undefined, options: [] };
const onSale = tickets.status === 'sprzedaz' && Boolean(tickets.url);
// Bezpłatna pozycja (np. otwarty wykład bez zapisów) nie dostaje automatycznie przycisku zakupu.
const isFree = (price?: string) => /^\s*0([,.]0+)?\s*(zł|pln)?\s*$/i.test(price ?? '');
const statusLabel = t(`tickets.status.${tickets.status}` as const);

// Bilety z tym samym polem „Grupa” (kolejne na liście) trafiają pod jeden nagłówek.
type Option = (typeof tickets.options)[number];
const groups = tickets.options.reduce<{ title?: string; items: Option[] }[]>((acc, o) => {
  const last = acc[acc.length - 1];
  if (last && (last.title ?? '') === (o.group ?? '')) last.items.push(o);
  else acc.push({ title: o.group, items: [o] });
  return acc;
}, []);
// Przycisk: własny link biletu albo – gdy sprzedaż trwa – link do sprzedaży. Bez przycisku dla
// pozycji bezpłatnych i planowanych.
const buyUrl = (o: Option) =>
  o.url || (tickets.status === 'sprzedaz' && !o.planned && !isFree(o.price) ? tickets.url : undefined);

// „Zakup online” pokazujemy dopiero, gdy sprzedaż naprawdę trwa.
const features = [
  { icon: 'file', text: t('tickets.invoice') },
  onSale && { icon: 'ticket', text: t('tickets.online') },
  { icon: 'users', text: t('tickets.limited') },
].filter(Boolean) as { icon: string; text: string }[];
---

<div class="tickets">
  <div class="ticket">
    <div class="ticket__main">
      <p class:list={['tag', onSale ? 'tag--solid' : 'tag--red']}>
        {onSale && <span class="dot dot--live" />}
        {statusLabel}
      </p>
      {tickets.info && <p class="ticket__info">{tr(tickets.info, locale)}</p>}

      <div class="ticket__cta">
        {
          onSale ? (
            <a class="btn btn--primary" href={tickets.url} target="_blank" rel="noopener noreferrer">
              <Icon name="ticket" size={18} />
              {t('cta.buyTicket')}
              <span class="visually-hidden"> {t('misc.newTab')}</span>
            </a>
          ) : (
            tickets.status === 'wkrotce' &&
            site.social.instagram && (
              <a class="btn" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
                <Icon name="instagram" size={18} />
                {t('cta.followIg')}
              </a>
            )
          )
        }
      </div>
    </div>

    <div class="ticket__stub" aria-hidden="false">
      <ul role="list" class="ticket__features">
        {
          features.map((f) => (
            <li>
              <Icon name={f.icon} size={20} />
              <span>{f.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="ticket__questions">
        {t('tickets.questions')}{' '}
        <a href={`mailto:${site.contact.email}`}>
          {site.contact.email.split('@')[0]}<wbr />@{site.contact.email.split('@')[1]}
        </a>
      </p>
    </div>
  </div>

  {
    groups.length > 0 && (
      <div
        class:list={['paths', { 'paths--odd': groups.length % 2 === 1 }]}
        style={`--rows:${Math.max(...groups.map((g) => g.items.length)) + 1}`}
      >
      {
          groups.map((g) => (
            <section class="path">
              {g.title && (
                <p class="path__title">
                  {/* Data po „·” nie rozdziela się na dwie linie */}
                  {tr(g.title, locale)
                    .split(' · ')
                    .map((part, i) => (i === 0 ? part : <>{'\u00a0· '}<span class="nowrap">{part}</span></>))}
                </p>
              )}
              <ul role="list" class="ticket__options">
                {g.items.map((o) => (
                  <li class="ticket__option">
                    <div>
                      {o.planned && <p class="ticket__badge">{t('tickets.planned')}</p>}
                      <p class="ticket__option-name">{tr(o.name, locale)}</p>
                      {o.description && <p class="ticket__option-desc">{tr(o.description, locale)}</p>}
                    </div>
                    <div class="ticket__option-side">
                      {o.price && (
                        <p class="ticket__price">
                          {isFree(o.price) ? t('tickets.free') : tr(o.price, locale)}
                          {o.priceNote ? (
                            <span class="ticket__price-note">{tr(o.priceNote, locale)}</span>
                          ) : (
                            // Pusta linijka, żeby ceny w sąsiednich kafelkach stały na jednej wysokości
                            <span class="ticket__price-note" aria-hidden="true">&nbsp;</span>
                          )}
                        </p>
                      )}
                      {buyUrl(o) && (
                        <a
                          class="btn btn--small btn--primary"
                          href={buyUrl(o)}
                          target={buyUrl(o)?.startsWith('mailto:') ? undefined : '_blank'}
                          rel="noopener noreferrer"
                        >
                          {tr(o.buttonLabel, locale) || t('tickets.buy')}
                          <span class="visually-hidden">
                            {' '}
                            {tr(o.name, locale)} {t('misc.newTab')}
                          </span>
                        </a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    )
  }
</div>

<style>
  .ticket {
    --notch: 1.1rem;
    display: grid;
    background: var(--c-paper);
    color: var(--c-paper-text);
    border-radius: var(--radius-l);
    position: relative;
    box-shadow: var(--shadow);
  }

  @media (min-width: 56rem) {
    .ticket {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      -webkit-mask:
        radial-gradient(circle at 60% 0, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) top / 100% 51% no-repeat,
        radial-gradient(circle at 60% 100%, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) bottom / 100% 51% no-repeat;
      mask:
        radial-gradient(circle at 60% 0, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) top / 100% 51% no-repeat,
        radial-gradient(circle at 60% 100%, transparent var(--notch), #000 calc(var(--notch) + 0.5px)) bottom / 100% 51% no-repeat;
    }
  }

  .ticket__main {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  .ticket__info {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 36rem;
  }

  .tickets {
    display: grid;
    gap: var(--gap, 1.25rem);
  }

  /* Ścieżki udziału: kafelki 2 w rzędzie, przy nieparzystej liczbie ostatni na całą szerokość */
  .paths {
    display: grid;
    gap: var(--gap, 1.25rem);
  }

  @media (min-width: 56rem) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .paths--odd > .path:last-child {
      grid-column: 1 / -1;
    }
  }

  .path {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    background: var(--c-paper);
    color: var(--c-paper-text);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow);
  }

  .path .nowrap {
    white-space: nowrap;
  }

  .path__title {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-red);
  }

  .path .ticket__options {
    border-top: 0;
  }

  /* Bilet w kafelku: opis u góry, cena i przycisk zawsze na dole */
  .path .ticket__option {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: space-between;
  }

  /*
   * Dwa kafelki obok siebie: wspólne wiersze (podsiatka) – nagłówki, pierwsze bilety, drugie
   * bilety i ich ceny stoją na tej samej wysokości w obu kafelkach rzędu.
   */
  @media (min-width: 56rem) {
    .path {
      grid-row: span var(--rows);
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    .path__title {
      padding-bottom: 0.25rem;
    }

    .path .ticket__options {
      grid-row: span calc(var(--rows) - 1);
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }

  .path .ticket__option:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .ticket__options {
    width: 100%;
    display: grid;
    border-top: 1px solid #d6cfbf;
  }

  .ticket__badge {
    display: inline-block;
    margin-bottom: 0.4rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--c-paper-2);
    border: 1px solid #cfc6b3;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.04em;
    vertical-align: middle;
    white-space: nowrap;
  }

  .ticket__option {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid #d6cfbf;
  }

  .ticket__option-name {
    font-weight: 800;
    font-size: var(--step-1);
  }

  .ticket__option-desc {
    color: var(--c-paper-muted);
    font-size: var(--step--1);
  }

  .ticket__option-side {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ticket__price {
    display: grid;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    white-space: nowrap;
  }

  .ticket__price-note {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--c-paper-muted);
  }

  .ticket__cta:empty {
    display: none;
  }

  .ticket__cta .btn:not(.btn--primary) {
    --btn-fg: var(--c-paper-text);
    --btn-border: var(--c-paper-text);
  }

  .ticket__stub {
    display: grid;
    gap: 1.5rem;
    align-content: space-between;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-top: 2px dashed #cfc6b3;
    background: var(--c-paper-2);
  }

  @media (min-width: 56rem) {
    .ticket__stub {
      border-top: 0;
      border-left: 2px dashed #cfc6b3;
    }
  }

  .ticket__features {
    display: grid;
    gap: 0.9rem;
  }

  .ticket__features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
  }

  .ticket__features :global(svg) {
    flex: none;
    color: var(--c-red);
  }

  .ticket__questions {
    font-size: var(--step--1);
    color: var(--c-paper-muted);
  }

  .ticket__questions a {
    display: inline-block;
    color: var(--c-paper-text);
    font-weight: 700;
  }
</style>
