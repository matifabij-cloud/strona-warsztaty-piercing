---
import Img from './Img.astro';
import { tr, useUI, type Locale } from '../i18n';
import type { Speaker } from '../lib/content';
import { md } from '../lib/markdown';

interface Props {
  locale: Locale;
  items: { speaker: Speaker; note?: string }[];
  showBio?: boolean;
}

const { locale, items, showBio = false } = Astro.props;
const t = useUI(locale);

const initials = (name: string) =>
  name
    .split(/[\s&]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// 1–2 osoby: poziome karty ze zdjęciem obok opisu, żeby sekcja nie wyglądała pusto.
const feature = items.length <= 2;

const igUrl = (v: string) => (/^https?:\/\//.test(v) ? v : `https://www.instagram.com/${v.replace(/^@/, '')}/`);
---

<ul role="list" class:list={['speakers', { 'speakers--feature': feature, 'speakers--solo': items.length === 1 }]}>
  {
    items.map(({ speaker, note }) => {
      const s = speaker.data;
      const bio = (showBio || feature) && speaker.body?.trim() ? md(tr(speaker.body, locale)) : '';
      return (
        <li class:list={['speaker', { 'speaker--nophoto': !s.photo }]}>
          <div class="speaker__photo">
            {s.photo ? (
              <Img src={s.photo} alt={s.name} widths={[320, 480, 720]} sizes="(min-width: 64rem) 20vw, (min-width: 40rem) 33vw, 50vw" />
            ) : (
              <span class="speaker__initials" aria-hidden="true">
                {initials(s.name)}
              </span>
            )}
            {note && <span class="speaker__note">{tr(note, locale)}</span>}
          </div>
          <div class="speaker__body">
            <h3 class="speaker__name">{s.name}</h3>
            {s.role && <p class="speaker__role">{tr(s.role, locale)}</p>}
            {s.country && <p class="speaker__country">{tr(s.country, locale)}</p>}
            {bio && feature && <div class="prose speaker__text" set:html={bio} />}
            {bio && !feature && (
              <details class="speaker__bio">
                <summary>{t('misc.readMore')}</summary>
                <div class="prose" set:html={bio} />
              </details>
            )}
            {(s.instagram || s.website) && (
              <p class="speaker__links">
                {s.instagram && (
                  <a href={igUrl(s.instagram)} target="_blank" rel="noopener noreferrer">
                    Instagram
                  </a>
                )}
                {s.website && (
                  <a href={s.website} target="_blank" rel="noopener noreferrer">
                    WWW
                  </a>
                )}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .speakers {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
  }

  @media (max-width: 30rem) {
    .speakers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }
  }

  /* 1–2 prelegentów: poziome karty */
  .speakers.speakers--feature {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
  }

  .speakers--solo {
    max-width: 56rem;
  }

  .speakers--feature .speaker {
    grid-template-columns: minmax(6.5rem, 2fr) minmax(0, 3fr);
    align-items: center;
    gap: 1rem clamp(1rem, 0.5rem + 2vw, 2rem);
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: linear-gradient(160deg, var(--c-bg-3), var(--c-bg-2));
  }

  .speakers--feature .speaker--nophoto {
    grid-template-columns: minmax(5.5rem, 9rem) minmax(0, 1fr);
  }

  .speakers--feature .speaker--nophoto .speaker__photo {
    aspect-ratio: 1;
  }

  .speakers--feature .speaker__photo {
    border-radius: var(--radius);
  }

  .speakers--feature .speaker__body {
    gap: 0.5rem;
  }

  .speaker__text {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--c-muted);
    line-height: 1.6;
  }

  @media (max-width: 30rem) {
    .speakers--feature .speaker__note {
      left: 0.4rem;
      right: 0.4rem;
      bottom: 0.4rem;
      max-width: calc(100% - 0.8rem);
      font-size: 0.65rem;
    }
  }

  .speaker {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .speaker__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--c-bg-3);
    isolation: isolate;
  }

  .speaker__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    filter: grayscale(1) contrast(1.1) brightness(0.95);
    transition:
      filter 0.5s var(--ease),
      scale 0.6s var(--ease);
  }

  .speaker:hover .speaker__photo :global(img) {
    filter: none;
    scale: 1.04;
  }

  .speaker__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(15 14 16 / 0.55), transparent 45%);
    pointer-events: none;
  }

  .speaker__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    color: var(--c-ink);
    background: linear-gradient(var(--c-yellow) 50%, var(--c-red) 50%);
  }

  .speaker__note {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    justify-self: start;
    display: inline-block;
    width: fit-content;
    max-width: calc(100% - 1.5rem);
    padding: 0.4em 0.75em;
    border-radius: 0.5rem;
    background: var(--c-yellow);
    color: var(--c-ink);
    font-size: var(--step--2);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .speaker__body {
    display: grid;
    gap: 0.3rem;
  }

  .speaker__name {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--step-2);
    line-height: 1.22;
  }

  .speaker__role {
    color: var(--c-muted);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .speaker__country {
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .speaker__bio {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--c-muted);
  }

  .speaker__bio summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--c-text);
    width: fit-content;
  }

  .speaker__bio[open] summary {
    margin-bottom: 0.5rem;
  }

  .speaker__links {
    display: flex;
    gap: 1rem;
    font-size: var(--step--1);
    font-weight: 700;
  }

  .speaker__links a {
    color: var(--accent);
  }
</style>
