---
/**
 * Zdjęcie z panelu (ścieżka „/media/…”) albo zaimportowany obraz.
 * Astro tworzy z niego kilka lekkich wersji WebP, a przeglądarka pobiera tę,
 * która pasuje do ekranu.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { dims, resolveMedia } from '../lib/media';

interface Props {
  src: string | ImageMetadata | undefined | null;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  quality?: number;
  style?: string;
}

const {
  src,
  alt,
  widths = [480, 800, 1200],
  sizes = '(min-width: 64rem) 50vw, 100vw',
  class: className,
  loading = 'lazy',
  fetchpriority,
  quality = 78,
  style,
} = Astro.props;

const image = typeof src === 'string' || src == null ? await resolveMedia(src) : src;
// Nie powiększamy ponad oryginał.
const maxWidth = image ? dims(image).width : 0;
const usable = image ? [...new Set(widths.map((w) => Math.min(w, maxWidth)))].sort((a, b) => a - b) : [];
---

{
  image && (
    <Image
      src={image}
      alt={alt}
      widths={usable}
      sizes={sizes}
      format="webp"
      quality={quality}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      fetchpriority={fetchpriority}
      class={className}
      style={style}
    />
  )
}
