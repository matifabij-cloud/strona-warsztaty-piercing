---
/**
 * Ikony (Lucide) + znaki serwisów społecznościowych.
 * Nazwy „brazil”, „snake” itd. można wybrać w panelu przy atrakcjach.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Award from '@lucide/astro/icons/award';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Brush from '@lucide/astro/icons/brush';
import CableCar from '@lucide/astro/icons/cable-car';
import Calendar from '@lucide/astro/icons/calendar-days';
import Camera from '@lucide/astro/icons/camera';
import Check from '@lucide/astro/icons/check';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Clock from '@lucide/astro/icons/clock';
import Crown from '@lucide/astro/icons/crown';
import Drama from '@lucide/astro/icons/drama';
import FileText from '@lucide/astro/icons/file-text';
import Gem from '@lucide/astro/icons/gem';
import Globe from '@lucide/astro/icons/globe';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Heart from '@lucide/astro/icons/heart';
import Images from '@lucide/astro/icons/images';
import Languages from '@lucide/astro/icons/languages';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Menu from '@lucide/astro/icons/menu';
import Mic from '@lucide/astro/icons/mic';
import Palette from '@lucide/astro/icons/palette';
import PartyPopper from '@lucide/astro/icons/party-popper';
import Phone from '@lucide/astro/icons/phone';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import ShoppingBag from '@lucide/astro/icons/shopping-bag';
import Smile from '@lucide/astro/icons/face-grinning';
import Sparkles from '@lucide/astro/icons/sparkles';
import Star from '@lucide/astro/icons/star';
import Ticket from '@lucide/astro/icons/ticket';
import TramFront from '@lucide/astro/icons/tram-front';
import Trophy from '@lucide/astro/icons/trophy';
import Users from '@lucide/astro/icons/users';
import X from '@lucide/astro/icons/x';
import Zap from '@lucide/astro/icons/zap';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  'stroke-width'?: number;
}

const { name, size = 24, class: className, 'stroke-width': strokeWidth = 2 } = Astro.props;

const icons: Record<string, any> = {
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  award: Award,
  badge: BadgeCheck,
  bag: ShoppingBag,
  brush: Brush,
  calendar: Calendar,
  camera: Camera,
  check: Check,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  clock: Clock,
  crown: Crown,
  drama: Drama,
  file: FileText,
  gem: Gem,
  globe: Globe,
  graduation: GraduationCap,
  heart: Heart,
  images: Images,
  languages: Languages,
  mail: Mail,
  'map-pin': MapPin,
  menu: Menu,
  mic: Mic,
  palette: Palette,
  party: PartyPopper,
  phone: Phone,
  shield: ShieldCheck,
  smile: Smile,
  sparkles: Sparkles,
  star: Star,
  ticket: Ticket,
  tram: TramFront,
  trophy: Trophy,
  users: Users,
  x: X,
  zap: Zap,
  zipline: CableCar,
};

const Lucide = icons[name];
const custom = ['instagram', 'facebook', 'tiktok', 'youtube', 'brazil', 'snake', 'ring'].includes(name);
const Fallback = Sparkles;
---

{
  custom ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
      focusable="false"
    >
      {name === 'instagram' && (
        <>
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
        </>
      )}
      {name === 'facebook' && <path d="M14 8.5h2.5V5H14c-2.5 0-4 1.6-4 4v2H8v3.5h2V21h3.5v-6.5h2.6l.4-3.5h-3V9.3c0-.5.3-.8.5-.8z" />}
      {name === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.3 4.6 5 5" />}
      {name === 'youtube' && (
        <>
          <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
          <path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor" />
        </>
      )}
      {name === 'brazil' && (
        <>
          <path d="M12 3.5 21 12l-9 8.5L3 12z" />
          <circle cx="12" cy="12" r="3.6" />
          <path d="M8.6 11.2c2.3-.6 4.6-.2 6.8 1" />
        </>
      )}
      {name === 'snake' && (
        <>
          <path d="M4 15c2.5 0 3-2 5.5-2s3 2 5.5 2 3-2 5-2" />
          <path d="M4 10.5c2.5 0 3-2 5.5-2s3 2 5.5 2 3-2 5-2" />
          <circle cx="7.5" cy="18.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="16.5" cy="18.5" r="1.2" fill="currentColor" stroke="none" />
        </>
      )}
      {name === 'ring' && (
        <>
          <path d="M16.6 5.6A8 8 0 1 0 19.6 10" />
          <circle cx="18.7" cy="7.2" r="1.8" fill="currentColor" stroke="none" />
        </>
      )}
    </svg>
  ) : Lucide ? (
    <Lucide size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" focusable="false" />
  ) : (
    <Fallback size={size} class={className} stroke-width={strokeWidth} aria-hidden="true" focusable="false" />
  )
}
