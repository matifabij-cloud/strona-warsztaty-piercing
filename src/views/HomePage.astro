---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import SectionHead from '../components/SectionHead.astro';
import Attractions from '../components/Attractions.astro';
import Speakers from '../components/Speakers.astro';
import Program from '../components/Program.astro';
import Tickets from '../components/Tickets.astro';
import OpenCall from '../components/OpenCall.astro';
import Partners from '../components/Partners.astro';
import EditionCard from '../components/EditionCard.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { alternatesFor, paths, tr, useUI, type Locale } from '../i18n';
import { editionPhase, getCurrentEdition, getEditions, getEditionSpeakers, accentColor } from '../lib/content';
import { md } from '../lib/markdown';
import { resolveMedia } from '../lib/media';
import { eventLd, organizationLd } from '../lib/seo';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);

const editions = await getEditions();
const current = await getCurrentEdition();
if (!current) throw new Error('Brak edycji w src/content/editions – dodaj przynajmniej jedną.');
const d = current.data;
const phase = editionPhase(current);
const ticketsOnSale = d.tickets?.status === 'sprzedaz' && Boolean(d.tickets?.url);

const speakers = await getEditionSpeakers(current);
const others = editions.filter((e) => e.id !== current.id);
const withPhotos = editions.find((e) => e.id !== current.id && e.data.gallery.length > 0) ?? editions.find((e) => e.data.gallery.length > 0);
const igFallback = [...d.posters, ...(withPhotos?.data.gallery ?? [])].slice(0, 6);

const body = current.body?.trim() ? md(tr(current.body, locale)) : '';

const cover = await resolveMedia(d.cover);
const coverUrl = cover ? new URL((await getImage({ src: cover, width: 1200, format: 'jpg' })).src, Astro.site).href : undefined;
const pageUrl = new URL(paths.home(locale), Astro.site).href;
const jsonLd = [
  organizationLd(new URL('/', Astro.site)),
  eventLd(current, locale, pageUrl, coverUrl, speakers.map((s) => s.speaker.data.name)),
].filter(Boolean) as Record<string, unknown>[];
---

<Base
  locale={locale}
  description={tr(site.description, locale)}
  image={d.cover}
  alternates={alternatesFor(paths.home)}
  jsonLd={jsonLd}
  ticketsOnSale={ticketsOnSale}
  accent={accentColor[d.accent]}
>
  <Hero locale={locale} edition={current} ticketsOnSale={ticketsOnSale} />
  <Stats locale={locale} stats={d.stats} />

  <!-- O wydarzeniu + atrakcje -->
    <section id="event" class="section" aria-labelledby="event-title">
      <div class="container">
        <div class="event-intro">
          <SectionHead id="event-title" eyebrow={t('section.about')} title={t('section.attractions')} />
          {body && <div class="prose prose--large event-intro__text" set:html={body} />}
        </div>
        {d.attractions.length > 0 && <Attractions locale={locale} items={d.attractions} />}
      </div>
    </section>

    <!-- Prelegenci -->
    {
      speakers.length > 0 && (
        <section id="speakers" class="section" aria-labelledby="speakers-title">
          <div class="container">
            <SectionHead id="speakers-title" eyebrow={t('hero.edition', { n: d.number })} title={t('section.speakers')} />
            <Speakers locale={locale} items={speakers} />
          </div>
        </section>
      )
    }

    <!-- Program -->
    <section id="program" class="section" aria-labelledby="program-title">
      <div class="container">
        <SectionHead id="program-title" eyebrow={tr(d.title, locale)} title={t('section.program')} />
        <Program locale={locale} edition={current} />
      </div>
    </section>

    <!-- Bilety -->
    {
      phase !== 'past' && (
        <section id="tickets" class="section" aria-labelledby="tickets-title">
          <div class="container">
            <SectionHead id="tickets-title" eyebrow={tr(d.title, locale)} title={t('section.tickets')} />
            <Tickets locale={locale} edition={current} />
          </div>
        </section>
      )
    }

  <!-- Nabór artystów -->
  {
    d.openCall?.enabled && (
      <section id="open-call" class="section section--paper" aria-label={t('section.openCall')}>
        <div class="container">
          <OpenCall locale={locale} call={d.openCall} />
        </div>
      </section>
    )
  }

  <!-- Partnerzy -->
  {
    d.partners.length > 0 && (
      <section id="partners" class="section" aria-labelledby="partners-title">
        <div class="container">
          <SectionHead id="partners-title" eyebrow={tr(d.title, locale)} title={t('section.partners')} />
          <Partners locale={locale} items={d.partners} />
        </div>
      </section>
    )
  }

  <!-- O projekcie -->
  <section id="about" class="section section--raised" aria-labelledby="about-title">
    <div class="container about">
      <div class="about__text">
        <SectionHead id="about-title" eyebrow={t('section.project')} title={tr(site.about.title, locale)} />
        <div class="prose prose--large" set:html={md(tr(site.about.text, locale))} />
        <a class="link-arrow" href={paths.editions(locale)}>
          {t('cta.allEditions')}
          <Icon name="arrow-right" />
        </a>
      </div>
      {
        site.about.images.length > 0 && (
          <div class="about__collage" aria-hidden="true">
            {site.about.images.slice(0, 3).map((src, i) => (
              <div class={`about__photo about__photo--${i + 1}`}>
                <Img src={src} alt="" widths={[360, 560, 800]} sizes="(min-width: 64rem) 28vw, 70vw" />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Poprzednie edycje -->
  {
    others.length > 0 && (
      <section id="editions" class="section section--raised" aria-labelledby="editions-title">
        <div class="container">
          <SectionHead id="editions-title" eyebrow={site.name} title={t('section.editions')} lead={t('editions.intro')}>
            <a class="btn" href={paths.editions(locale)}>
              {t('cta.allEditions')}
              <Icon name="arrow-right" size={18} />
            </a>
          </SectionHead>
          <div class="grid-auto" style="--min: 18rem">
            {others.slice(0, 3).map((e) => (
              <EditionCard locale={locale} edition={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Galeria -->
  {
    withPhotos && (
      <section id="gallery" class="section" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead
            id="gallery-title"
            eyebrow={t('gallery.fromEdition', { n: withPhotos.data.number })}
            title={t('section.gallery')}
            lead={tr(withPhotos.data.title, locale)}
          />
          <Gallery
            locale={locale}
            images={withPhotos.data.gallery}
            label={t('hero.edition', { n: withPhotos.data.number })}
            initial={8}
            id="home-gallery"
          />
        </div>
      </section>
    )
  }

  <!-- Instagram -->
  <section id="instagram" class="section" aria-labelledby="ig-title">
    <div class="container">
      <SectionHead id="ig-title" eyebrow="Instagram" title={t('section.instagram')} lead={t('instagram.intro')} />
      <InstagramFeed locale={locale} fallback={igFallback} />
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <SectionHead id="faq-title" eyebrow="FAQ" title={t('section.faq')} />
      <Faq locale={locale} />
    </div>
  </section>

  <!-- Kontakt -->
  <section id="contact" class="section section--raised" aria-labelledby="contact-title">
    <div class="container">
      <SectionHead id="contact-title" eyebrow={t('section.contact')} title={t('cta.write')} lead={t('contact.intro')} />
      <Contact locale={locale} />
    </div>
  </section>

  <Lightbox locale={locale} />
</Base>

<style>
  .event-intro {
    display: grid;
    gap: 1rem 4rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 64rem) {
    .event-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .event-intro :global(.section-head) {
      margin-bottom: 0;
    }
  }

  .event-intro__text {
    color: var(--c-muted);
  }

  .about {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .about__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .about__text :global(.section-head) {
    margin-bottom: 0;
  }

  .about__text .prose {
    color: var(--c-muted);
  }

  .about__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    aspect-ratio: 1 / 0.9;
    width: min(100%, 36rem);
    margin-inline: auto;
  }

  .about__photo {
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--c-bg-3);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__photo--1 {
    grid-area: 1 / 1 / 5 / 5;
    rotate: -3deg;
    z-index: 1;
  }

  .about__photo--2 {
    grid-area: 2 / 4 / 6 / 7;
    rotate: 4deg;
    z-index: 2;
    border: 4px solid var(--c-bg-2);
  }

  .about__photo--3 {
    grid-area: 4 / 2 / 7 / 5;
    rotate: -1deg;
    z-index: 3;
    border: 4px solid var(--c-bg-2);
  }

  .faq-layout {
    display: grid;
    gap: 1rem 4rem;
  }

  @media (min-width: 64rem) {
    .faq-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .faq-layout :global(.section-head) {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
