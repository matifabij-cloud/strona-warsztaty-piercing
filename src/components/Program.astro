---
import Icon from './Icon.astro';
import { formatDate, formatWeekday, tr, useUI, type Locale } from '../i18n';
import { programHosts, type Edition } from '../lib/content';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
  edition: Edition;
}

const { locale, edition } = Astro.props;
const t = useUI(locale);
const days = edition.data.program.filter((d) => d.items.length > 0);

const rendered = await Promise.all(
  days.map(async (day, i) => ({
    heading: day.label ? tr(day.label, locale) : day.day ? formatWeekday(day.day, locale) : t('program.day', { n: i + 1 }),
    date: day.day ? formatDate(day.day, locale) : '',
    items: await Promise.all(day.items.map(async (item) => ({ ...item, hosts: await programHosts(item) }))),
  })),
);
// Dni o bardzo różnej liczbie punktów nie stoją obok siebie (jedna kolumna byłaby dużo dłuższa):
// wtedy każdy dzień zajmuje całą szerokość, a jego punkty układają się w kafelki obok siebie.
const counts = rendered.map((d) => d.items.length);
const stacked = rendered.length > 1 && Math.max(...counts) - Math.min(...counts) > 1;
---

{
  rendered.length > 0 ? (
    <div
      class:list={[
        'program',
        stacked
          ? 'program--stacked'
          : { 'program--two': rendered.length > 1, 'program--odd': rendered.length > 1 && rendered.length % 2 === 1, 'program--three': rendered.length === 3 },
      ]}
    >
      {rendered.map((day) => (
        <section class="program__day" aria-label={`${day.heading} ${day.date}`}>
          <header class="program__head">
            <h3>{day.heading}</h3>
            {day.date && <p>{day.date}</p>}
          </header>
          <ol role="list" class="program__items">
            {day.items.map((item) => (
              <li class="program__item">
                <span class="program__time">{item.time}</span>
                <div class="program__info">
                  <p class="program__title">{tr(item.title, locale)}</p>
                  {item.hosts.length > 0 && (
                    <p class="program__hosts">
                      <Icon name="mic" size={16} />
                      {item.hosts.join(', ')}
                    </p>
                  )}
                  {item.description && <p class="program__desc">{tr(item.description, locale)}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  ) : (
    <div class="program-soon">
      <Icon name="clock" size={32} stroke-width={1.6} />
      <p>{t('program.soon')}</p>
      {site.social.instagram && (
        <a class="btn" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size={18} />
          {t('cta.followIg')}
        </a>
      )}
    </div>
  )
}

<style>
  .program {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1.5vw, 2rem);
  }

  @media (min-width: 60rem) {
    .program--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Nieparzysta liczba dni: ostatni dzień na całą szerokość, bez pustego miejsca obok */
    .program--odd > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Trzy dni: trzy kolumny obok siebie */
  @media (min-width: 72rem) {
    .program--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .program--three > :last-child {
      grid-column: auto;
    }
  }

  /* Układ „dzień pod dniem”: punkty programu jako kafelki w rzędzie */
  .program--stacked .program__items {
    gap: 0.75rem;
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
  }

  @media (min-width: 48rem) {
    .program--stacked .program__items {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    }
  }

  .program--stacked .program__item,
  .program--stacked .program__item:first-child {
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-bg-3);
  }

  .program__day {
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-bg-2);
    overflow: hidden;
  }

  .program__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 1.1rem clamp(1.1rem, 1rem + 1vw, 1.75rem);
    background: var(--accent);
    color: var(--c-ink);
  }

  .program__head h3 {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .program__head p {
    font-weight: 800;
    font-size: var(--step--1);
  }

  .program__items {
    display: grid;
  }

  .program__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.15rem clamp(1.1rem, 1rem + 1vw, 1.75rem);
    border-top: 1px solid var(--c-line);
  }

  .program__item:first-child {
    border-top: 0;
  }

  .program__time {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .program__info {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .program__title {
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .program__hosts {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--c-text);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .program__hosts :global(svg) {
    color: var(--accent);
    flex: none;
  }

  .program__desc {
    color: var(--c-muted);
    font-size: var(--step--1);
  }

  .program-soon {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--radius-l);
    max-width: 44rem;
  }

  .program-soon :global(svg:first-child) {
    color: var(--accent);
  }

  .program-soon p {
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
