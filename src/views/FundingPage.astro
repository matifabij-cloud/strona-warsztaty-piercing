---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { alternatesFor, paths, tr, useUI, type Locale } from '../i18n';
import { md } from '../lib/markdown';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const entry = await getEntry('pages', 'dofinansowanie');
if (!entry) throw new Error('Brak strony src/content/pages/dofinansowanie.md');
const title = tr(entry.data.title, locale);
const html = md(tr(entry.body ?? '', locale));
const burUrl = 'https://uslugirozwojowe.parp.gov.pl/';
const serviceNumber = '2026/11/20/2020619/3962765';
---

<Base locale={locale} title={title} description={t('funding.subtitle')} alternates={alternatesFor(paths.funding)}>
  <article class="section funding">
    <div class="container--narrow">
      <h1 class="display funding__title">{title}</h1>
      <p class="funding__subtitle">{t('funding.subtitle')}</p>

      <div class="funding__box">
        <a class="btn btn--primary" href={burUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="arrow-up-right" size={18} />
          {t('funding.find')}
          <span class="visually-hidden"> {t('misc.newTab')}</span>
        </a>
        <div class="funding__number">
          <span class="funding__number-label">{t('funding.number')}</span>
          <code class="funding__number-value" data-copy-source>{serviceNumber}</code>
          <button class="btn btn--small" type="button" data-copy data-label-done={t('funding.copied')}>
            {t('funding.copy')}
          </button>
        </div>
      </div>

      <div class="prose funding__content" set:html={html} />
    </div>
  </article>
</Base>

<script>
  // Kopiowanie numeru usługi BUR jednym kliknięciem (wygodne na telefonie).
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      const value = btn.parentElement?.querySelector('[data-copy-source]')?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const range = document.createRange();
        const node = btn.parentElement?.querySelector('[data-copy-source]');
        if (node) {
          range.selectNodeContents(node);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
        }
        return;
      }
      btn.textContent = btn.dataset.labelDone ?? label;
      setTimeout(() => (btn.textContent = label), 2000);
    });
  });
</script>

<style>
  .funding {
    padding-top: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .funding__title {
    font-size: var(--step-4);
    margin-bottom: 0.75rem;
  }

  .funding__subtitle {
    font-size: var(--step-1);
    color: var(--c-muted);
    margin-bottom: 2rem;
  }

  .funding__box {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    margin-bottom: 2.5rem;
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--c-yellow);
    border-radius: var(--radius);
    background: var(--c-bg-2);
  }

  .funding__number {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .funding__number-label {
    width: 100%;
    font-size: var(--step--1);
    color: var(--c-muted);
  }

  .funding__number-value {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--c-text);
    user-select: all;
    overflow-wrap: anywhere;
  }

  .funding .prose {
    color: var(--c-muted);
  }

  /* Kroki: każdy w osobnej karcie z dużym numerem */
  .funding__content :global(ol) {
    list-style: none;
    padding: 0;
    margin-block: 1.5rem;
    display: grid;
    gap: 1rem;
    counter-reset: step;
  }

  .funding__content :global(ol > li) {
    counter-increment: step;
    position: relative;
    margin: 0;
    padding: 1.25rem 1.25rem 1.25rem 4.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-bg-2);
  }

  .funding__content :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 1.25rem;
    top: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--c-yellow);
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .funding__content :global(ol > li > p:first-child strong) {
    color: var(--c-text);
    font-size: var(--step-1);
  }

  .funding__content :global(ol > li > p) {
    margin-block: 0 0.6rem;
  }

  .funding__content :global(ol > li > p:last-child) {
    margin-bottom: 0;
  }

  .funding__content :global(blockquote) {
    margin-block: 1.25rem;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--c-yellow);
    background: var(--c-bg-2);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .funding__content :global(h3) {
    margin-top: 1.5rem;
  }
</style>
