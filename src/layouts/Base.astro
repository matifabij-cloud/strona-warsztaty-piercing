---
import '@fontsource/anton/latin.css';
import '@fontsource/anton/latin-ext.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import antonLatin from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import antonLatinExt from '@fontsource/anton/files/anton-latin-ext-400-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MailDialog from '../components/MailDialog.astro';
import ogDefault from '../assets/brand/og-default.jpg';
import { locales, localeMeta, tr, useUI, type Locale } from '../i18n';
import { resolveMedia } from '../lib/media';
import { site } from '../lib/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  alternates: Record<Locale, string>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ticketsOnSale?: boolean;
  /** Kolor przewodni (np. edycji) jako wartość CSS. */
  accent?: string;
}

const { locale, title, description, image, alternates, jsonLd, noindex = false, ticketsOnSale = false, accent } = Astro.props;
const t = useUI(locale);

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – ${description ?? ''}`.replace(/ – $/, '');
const metaDescription = (description ?? '').replace(/\s+/g, ' ').trim().slice(0, 300);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const ogSource = (typeof image === 'string' ? await resolveMedia(image) : image) ?? ogDefault;
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;

const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={localeMeta[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {locales.map((l) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={new URL(alternates[l], Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.pl, Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMeta[locale].og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0f0e10" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preload" href={antonLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={antonLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    {
      site.announcement.enabled && site.announcement.text && (
        <div class="announcement">
          {site.announcement.url ? <a href={site.announcement.url}>{tr(site.announcement.text, locale)}</a> : <span>{tr(site.announcement.text, locale)}</span>}
        </div>
      )
    }
    <Header locale={locale} alternates={alternates} ticketsOnSale={ticketsOnSale} />
    <main id="main" tabindex="-1" style={accent ? `--accent:${accent}` : undefined}>
      <slot />
    </main>
    <Footer locale={locale} />
    <MailDialog locale={locale} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    background: var(--c-yellow);
    color: var(--c-ink);
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }

  .announcement {
    background: var(--c-yellow);
    color: var(--c-ink);
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
    padding: 0.6rem var(--gutter);
  }

  .announcement a {
    color: inherit;
  }
</style>
